# Igual que .gitignore PERO incluye .env en el contexto del build, para que
# EAS hornee las EXPO_PUBLIC_* (Turso, PIN) en el APK.
# Para builds LOCALES el .env se queda en esta máquina.
# OJO: con esto, un build EN LA NUBE subiría el .env (con el token) a Expo.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — NO ignoramos .env (lo necesitamos en el build)
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build artifacts
*.apk
