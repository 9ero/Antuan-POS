{
  "expo": {
    "name": "Antuan POS",
    "slug": "AntuanPOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "groceryapp",
    "icon": "./assets/Antuan.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AntuanColor.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.antuan.pos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/Antuan.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4744ed42-7541-463a-92b8-4778f2171407"
      }
    }
  }
}
