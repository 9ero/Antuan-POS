{
  "expo": {
    "name": "Antuan POS",
    "slug": "AntuanPOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "groceryapp",
    "icon": "./assets/Antuan.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/AntuanColor.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AntuanColor.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/Antuan.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ]
  }
}